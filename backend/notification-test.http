### Notification Module Manual Test
### Usage: Copy these curl commands to your terminal or run via a REST client
### Make sure the backend is running on http://localhost:8080

# ============================================
# 1. SETUP: Create Provider, Booking, Accept/Reject/Complete, Pay
# ============================================

# 1.1 Register & Login Provider
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "AC Technician",
    "email": "technician_notif@test.com",
    "password": "Password123",
    "role": "PROVIDER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "technician_notif@test.com",
    "password": "Password123"
  }'

# 1.2 Create Provider Profile
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "businessName": "CoolAir Services",
    "description": "AC Maintenance and Installation",
    "phone": "9876543212",
    "experience": 4,
    "address": "50 Anna Salai"
  }'

# 1.3 Provider sets availability for Wednesday
curl -X POST http://localhost:8080/api/providers/me/schedule \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "dayOfWeek": "WEDNESDAY",
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "available": true
  }'

# 1.4 Register & Login Customer
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Customer Notif",
    "email": "customer_notif@test.com",
    "password": "Password123",
    "role": "CUSTOMER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "customer_notif@test.com",
    "password": "Password123"
  }'

# 1.5 Create Customer Address
curl -X POST http://localhost:8080/api/addresses \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "label": "Office",
    "addressLine1": "Tower 2, IT Corridor",
    "city": "Chennai",
    "state": "Tamil Nadu",
    "pincode": "600096",
    "isDefault": true
  }'

# 1.6 Admin creates category
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Admin Notif",
    "email": "admin_notif@test.com",
    "password": "Password123",
    "role": "ADMIN"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "admin_notif@test.com",
    "password": "Password123"
  }'

curl -X POST http://localhost:8080/api/categories \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ADMIN_TOKEN" \
  -d '{
    "name": "AC Repair-Notif",
    "description": "AC servicing"
  }'

# 1.7 Provider creates service
curl -X POST http://localhost:8080/api/services \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "categoryId": "YOUR_CATEGORY_ID",
    "title": "AC Filter Cleaning",
    "description": "Deep chemical cleaning of filters",
    "price": 800.0,
    "durationMinutes": 60
  }'

# ============================================
# 2. TRIGGER & TEST NOTIFICATIONS
# ============================================

# 2.1 Customer books service -> Provider receives BOOKING_CREATED notification
curl -X POST http://localhost:8080/api/bookings \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "serviceId": "YOUR_SERVICE_ID",
    "addressId": "YOUR_ADDRESS_ID",
    "bookingDate": "2026-10-14",
    "bookingTime": "15:00:00"
  }'

# 2.2 Provider checks their notifications -> Should contain BOOKING_CREATED, unread
curl -X GET http://localhost:8080/api/notifications/me \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.3 Provider accepts booking -> Customer receives BOOKING_ACCEPTED notification
curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/accept \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.4 Customer checks their notifications -> Should contain BOOKING_ACCEPTED
curl -X GET http://localhost:8080/api/notifications/me \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.5 Provider completes booking -> Customer receives SERVICE_COMPLETED notification
curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/complete \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.6 Customer initiates payment -> Provider receives PAYMENT_CONFIRMED notification
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.7 Provider marks single notification as read
curl -X PUT http://localhost:8080/api/notifications/YOUR_NOTIFICATION_ID/read \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.8 Customer marks all notifications as read
curl -X PUT http://localhost:8080/api/notifications/read-all \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.9 Negative test: User attempts to mark another user's notification as read -> Expect 404
curl -X PUT http://localhost:8080/api/notifications/YOUR_NOTIFICATION_ID/read \
  -H "Authorization: Bearer ANOTHER_USER_TOKEN"
