### Payment Module Manual Test
### Usage: Copy these curl commands to your terminal or run via a REST client
### Make sure the backend is running on http://localhost:8080

# ============================================
# 1. SETUP: Users, Provider, Service, Address, Booking
# ============================================

# 1.1 Register & Login Provider
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Provider One",
    "email": "provider_pay@test.com",
    "password": "Password123",
    "role": "PROVIDER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "provider_pay@test.com",
    "password": "Password123"
  }'

# 1.2 Create Provider Profile
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "businessName": "Express Electricians",
    "description": "Certified Electrical Repairs",
    "phone": "9876543210",
    "experience": 5,
    "address": "123 Main Street"
  }'

# 1.3 Set Provider Availability (e.g. Wednesday 09:00 - 18:00)
curl -X POST http://localhost:8080/api/providers/me/schedule \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "dayOfWeek": "WEDNESDAY",
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "available": true
  }'

# 1.4 Register & Login Customer
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Customer One",
    "email": "customer_pay@test.com",
    "password": "Password123",
    "role": "CUSTOMER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "customer_pay@test.com",
    "password": "Password123"
  }'

# 1.5 Create Customer Address
curl -X POST http://localhost:8080/api/addresses \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "label": "Home",
    "addressLine1": "45 Green Avenue",
    "city": "Chennai",
    "state": "Tamil Nadu",
    "pincode": "600001",
    "isDefault": true
  }'

# 1.6 Login as Admin and Create Category
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Admin User",
    "email": "admin_pay@test.com",
    "password": "Password123",
    "role": "ADMIN"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "admin_pay@test.com",
    "password": "Password123"
  }'

curl -X POST http://localhost:8080/api/categories \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ADMIN_TOKEN" \
  -d '{
    "name": "Electrical-Pay",
    "description": "Electrical wiring and fixes"
  }'

# 1.7 Provider Creates Service (₹1,000)
curl -X POST http://localhost:8080/api/services \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "categoryId": "YOUR_CATEGORY_ID",
    "title": "Switchboard Setup",
    "description": "Full board wiring",
    "price": 1000.0,
    "durationMinutes": 60
  }'

# 1.8 Customer Creates Booking
curl -X POST http://localhost:8080/api/bookings \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "serviceId": "YOUR_SERVICE_ID",
    "addressId": "YOUR_ADDRESS_ID",
    "bookingDate": "2026-10-14",
    "bookingTime": "10:00:00"
  }'

# ============================================
# 2. PAYMENT TESTS
# ============================================

# 2.1 NEGATIVE TEST: Pay for PENDING booking (should return 409 Conflict)
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.2 Provider Accepts and Completes Booking
curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/accept \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/complete \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.3 NEGATIVE TEST: Non-owner / unauthorized user attempts to pay (should return 404 / Forbidden)
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ANOTHER_USER_TOKEN"

# 2.4 POSITIVE TEST: Customer pays for COMPLETED booking (₹1,000 -> 10% platform: ₹100, payout: ₹900)
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.5 NEGATIVE TEST: Duplicate payment on same booking (should return 409 Conflict)
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.6 POSITIVE TEST: Customer gets payment details by booking ID
curl -X GET http://localhost:8080/api/payments/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.7 POSITIVE TEST: Provider gets payment details by booking ID
curl -X GET http://localhost:8080/api/payments/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.8 NEGATIVE TEST: Unrelated user tries to view booking payment (should return 404)
curl -X GET http://localhost:8080/api/payments/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer ANOTHER_USER_TOKEN"

# 2.9 POSITIVE TEST: Provider checks earnings summary
curl -X GET http://localhost:8080/api/payments/provider/me/earnings \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.10 NEGATIVE TEST: Customer attempts to access provider earnings endpoint (should return 403 Forbidden)
curl -X GET http://localhost:8080/api/payments/provider/me/earnings \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"
