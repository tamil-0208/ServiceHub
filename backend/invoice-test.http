### Invoice Module Manual Test
### Usage: Copy these curl commands to your terminal or run via a REST client
### Make sure the backend is running on http://localhost:8080

# ============================================
# 1. SETUP: Complete Flow to Generate Invoice
# ============================================

# 1.1 Register & Login Provider
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Carpenter Pro",
    "email": "carpenter_inv@test.com",
    "password": "Password123",
    "role": "PROVIDER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "carpenter_inv@test.com",
    "password": "Password123"
  }'

# 1.2 Create Provider Profile
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "businessName": "WoodCraft Studios",
    "description": "Custom furniture and repairs",
    "phone": "9876543213",
    "experience": 8,
    "address": "77 Wood Street"
  }'

# 1.3 Provider sets availability for Wednesday
curl -X POST http://localhost:8080/api/providers/me/schedule \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "dayOfWeek": "WEDNESDAY",
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "available": true
  }'

# 1.4 Register & Login Customer
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Customer Invoice",
    "email": "customer_inv@test.com",
    "password": "Password123",
    "role": "CUSTOMER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "customer_inv@test.com",
    "password": "Password123"
  }'

# 1.5 Create Customer Address
curl -X POST http://localhost:8080/api/addresses \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "label": "Home",
    "addressLine1": "10 Pine Road",
    "city": "Bengaluru",
    "state": "Karnataka",
    "pincode": "560002",
    "isDefault": true
  }'

# 1.6 Admin creates category
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Admin Inv",
    "email": "admin_inv@test.com",
    "password": "Password123",
    "role": "ADMIN"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "admin_inv@test.com",
    "password": "Password123"
  }'

curl -X POST http://localhost:8080/api/categories \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ADMIN_TOKEN" \
  -d '{
    "name": "Carpentry-Inv",
    "description": "Woodworking and furniture"
  }'

# 1.7 Provider creates service (₹1,500)
curl -X POST http://localhost:8080/api/services \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "categoryId": "YOUR_CATEGORY_ID",
    "title": "Door Hinge Alignment",
    "description": "Aligning and fixing squeaky door hinges",
    "price": 1500.0,
    "durationMinutes": 60
  }'

# 1.8 Customer creates Booking
curl -X POST http://localhost:8080/api/bookings \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "serviceId": "YOUR_SERVICE_ID",
    "addressId": "YOUR_ADDRESS_ID",
    "bookingDate": "2026-10-14",
    "bookingTime": "16:00:00"
  }'

# 1.9 Provider accepts and completes the booking
curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/accept \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

curl -X PUT http://localhost:8080/api/bookings/YOUR_BOOKING_ID/complete \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# ============================================
# 2. TRIGGER & TEST INVOICE GENERATION
# ============================================

# 2.1 Customer initiates payment -> Automatically generates Invoice (e.g., INV-2026-000001)
curl -X POST http://localhost:8080/api/payments/initiate/YOUR_BOOKING_ID \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.2 POSITIVE TEST: Customer retrieves invoice for the booking -> Expect 200 OK
curl -X GET http://localhost:8080/api/invoices/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.3 POSITIVE TEST: Owning Provider retrieves invoice for the booking -> Expect 200 OK
curl -X GET http://localhost:8080/api/invoices/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# 2.4 NEGATIVE TEST: Unrelated user attempts to access invoice for the booking -> Expect 404 / Resource Not Found
curl -X GET http://localhost:8080/api/invoices/booking/YOUR_BOOKING_ID \
  -H "Authorization: Bearer ANOTHER_USER_TOKEN"

# 2.5 POSITIVE TEST: Customer views all their own invoices -> Expect 200 OK (list containing the invoice)
curl -X GET http://localhost:8080/api/invoices/me \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN"

# 2.6 POSITIVE TEST: Provider views all their own invoices -> Expect 200 OK (list containing the invoice)
curl -X GET http://localhost:8080/api/invoices/me \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"
