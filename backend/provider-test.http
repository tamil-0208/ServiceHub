### Provider Module Manual Test
### Usage: Copy these curl commands to your terminal, or use a REST client like Postman/Insomnia
### Make sure the backend is running on http://localhost:8080

# 1. Register a new user
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Test Provider",
    "email": "provider@test.com",
    "password": "Password123",
    "role": "PROVIDER"
  }'

# 2. Login to get JWT token
curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "provider@test.com",
    "password": "Password123"
  }'

# Save the token from the response above and use it in the following commands
# Replace YOUR_JWT_TOKEN_HERE with the actual token from the login response

# 3. Create a provider profile (should succeed with 201)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE" \
  -d '{
    "businessName": "Test Business",
    "description": "A test business for provider profile",
    "phone": "1234567890",
    "experience": "5 years",
    "address": "123 Test Street, Test City"
  }'

# 4. Fetch the provider profile (should succeed with 200)
curl -X GET http://localhost:8080/api/providers/me \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE"

# 5. Try to create a second provider profile (should fail with 409 Conflict)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE" \
  -d '{
    "businessName": "Another Business",
    "description": "This should fail",
    "phone": "9876543210",
    "experience": "2 years",
    "address": "456 Another Street"
  }'

# 6. Test validation - missing phone (should fail with 400 Bad Request)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE" \
  -d '{
    "businessName": "Test Business",
    "description": "Missing phone",
    "experience": "3 years"
  }'

# 7. Test validation - invalid phone format (should fail with 400 Bad Request)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE" \
  -d '{
    "businessName": "Test Business",
    "description": "Invalid phone format",
    "phone": "abc123",
    "experience": "3 years"
  }'

# 8. Test validation - missing business name (should fail with 400 Bad Request)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_JWT_TOKEN_HERE" \
  -d '{
    "description": "Missing business name",
    "phone": "1234567890",
    "experience": "3 years"
  }'

# 9. Try to fetch provider profile without authentication (should fail with 401)
curl -X GET http://localhost:8080/api/providers/me

# 10. Try to create provider profile without authentication (should fail with 401)
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -d '{
    "businessName": "Unauthorized Business",
    "phone": "1234567890"
  }'
