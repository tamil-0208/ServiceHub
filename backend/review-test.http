### Review & Rating Module Manual Test
### Usage: Copy these curl commands to your terminal or run via a REST client
### Make sure the backend is running on http://localhost:8080

# ============================================
# 1. SETUP: Create Provider, Booking (Pending vs Completed)
# ============================================

# 1.1 Register & Login Provider
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Super Plumber",
    "email": "plumber_review@test.com",
    "password": "Password123",
    "role": "PROVIDER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "plumber_review@test.com",
    "password": "Password123"
  }'

# 1.2 Create Provider Profile
curl -X POST http://localhost:8080/api/providers \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "businessName": "PlumbTech",
    "description": "Expert Pipe and Tap Repair",
    "phone": "9876543211",
    "experience": 7,
    "address": "22 North Road"
  }'

# 1.3 Set Schedule for Wednesday
curl -X POST http://localhost:8080/api/providers/me/schedule \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "dayOfWeek": "WEDNESDAY",
    "startTime": "09:00:00",
    "endTime": "18:00:00",
    "available": true
  }'

# 1.4 Register & Login Customer
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Customer Reviewer",
    "email": "customer_rev@test.com",
    "password": "Password123",
    "role": "CUSTOMER"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "customer_rev@test.com",
    "password": "Password123"
  }'

# 1.5 Create Customer Address
curl -X POST http://localhost:8080/api/addresses \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "label": "Home",
    "addressLine1": "Flat 3B, Sunshine Apartments",
    "city": "Bengaluru",
    "state": "Karnataka",
    "pincode": "560001",
    "isDefault": true
  }'

# 1.6 Admin creates category
curl -X POST http://localhost:8080/api/users/register \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Admin Review",
    "email": "admin_rev@test.com",
    "password": "Password123",
    "role": "ADMIN"
  }'

curl -X POST http://localhost:8080/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "admin_rev@test.com",
    "password": "Password123"
  }'

curl -X POST http://localhost:8080/api/categories \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ADMIN_TOKEN" \
  -d '{
    "name": "Plumbing-Rev",
    "description": "Pipes and leakages"
  }'

# 1.7 Provider creates service
curl -X POST http://localhost:8080/api/services \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN" \
  -d '{
    "categoryId": "YOUR_CATEGORY_ID",
    "title": "Pipe Leak Repair",
    "description": "Fixing leaking pipes and fittings",
    "price": 600.0,
    "durationMinutes": 45
  }'

# 1.8 Customer creates Booking 1 (Will stay PENDING)
curl -X POST http://localhost:8080/api/bookings \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "serviceId": "YOUR_SERVICE_ID",
    "addressId": "YOUR_ADDRESS_ID",
    "bookingDate": "2026-10-14",
    "bookingTime": "11:00:00"
  }'

# 1.9 Customer creates Booking 2 (Will be transitioned to COMPLETED)
curl -X POST http://localhost:8080/api/bookings \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "serviceId": "YOUR_SERVICE_ID",
    "addressId": "YOUR_ADDRESS_ID",
    "bookingDate": "2026-10-14",
    "bookingTime": "14:00:00"
  }'

# 1.10 Provider accepts & completes Booking 2
curl -X PUT http://localhost:8080/api/bookings/BOOKING_2_ID/accept \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

curl -X PUT http://localhost:8080/api/bookings/BOOKING_2_ID/complete \
  -H "Authorization: Bearer YOUR_PROVIDER_TOKEN"

# ============================================
# 2. REVIEW & RATING TESTS
# ============================================

# 2.1 NEGATIVE TEST: Attempt to review a booking that is NOT COMPLETED (Booking 1 is PENDING) -> Expect 409 Conflict
curl -X POST http://localhost:8080/api/reviews \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "bookingId": "BOOKING_1_ID",
    "rating": 5,
    "comment": "Nice work!"
  }'

# 2.2 NEGATIVE TEST: Invalid rating (rating = 6, must be between 1 and 5) -> Expect 400 Bad Request
curl -X POST http://localhost:8080/api/reviews \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "bookingId": "BOOKING_2_ID",
    "rating": 6,
    "comment": "Super service!"
  }'

# 2.3 NEGATIVE TEST: Non-owner / unauthorized user attempts to review Booking 2 -> Expect 404 / Resource Not Found
curl -X POST http://localhost:8080/api/reviews \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer ANOTHER_USER_TOKEN" \
  -d '{
    "bookingId": "BOOKING_2_ID",
    "rating": 5,
    "comment": "Trying to review someone elses booking"
  }'

# 2.4 POSITIVE TEST: Customer successfully submits review for COMPLETED Booking 2 -> Expect 201 Created
curl -X POST http://localhost:8080/api/reviews \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "bookingId": "BOOKING_2_ID",
    "rating": 5,
    "comment": "Punctual and very neat plumbing work!"
  }'

# 2.5 NEGATIVE TEST: Duplicate review for the same booking -> Expect 409 Conflict
curl -X POST http://localhost:8080/api/reviews \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_CUSTOMER_TOKEN" \
  -d '{
    "bookingId": "BOOKING_2_ID",
    "rating": 4,
    "comment": "Submitting another review"
  }'

# 2.6 POSITIVE TEST: Public paginated reviews for provider -> Expect 200 OK (page of reviews)
curl -X GET "http://localhost:8080/api/reviews/provider/YOUR_PROVIDER_ID?page=0&size=10"

# 2.7 POSITIVE TEST: Public provider rating summary (MongoDB aggregation query) -> Expect 200 OK (averageRating: 5.0, totalReviews: 1)
curl -X GET http://localhost:8080/api/providers/YOUR_PROVIDER_ID/rating-summary
